{
  "name": "cyberchef",
  "version": "1.0.0",
  "description": "The Cyber Swiss Army Knife",
  "author": "n1474335 <n1474335@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.cyberchef.cyberchef",
    "productName": "cyberchef",
    "copyright": "Copyright © 2026 cyberchef",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "images/**/*",
      "index.html"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}